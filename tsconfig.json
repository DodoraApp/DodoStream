{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    // TS 6 no longer auto-includes @types/*. Jest globals are needed by every
    // test file; Node globals are referenced file-locally (app.config.ts gets
    // `process` from expo/types; scripts/sync-e2e/* reference node explicitly).
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["packages"]
}
