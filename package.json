{
  "name": "dodostream",
  "version": "0.12.3",
  "license": "GPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:dev:local": "eas build --profile development --local",
    "build:dev:tv": "eas build --profile development_tv",
    "build:dev:tv:local": "eas build --profile development_tv --local",
    "build:production": "eas build --profile production",
    "build:production:local": "eas build --profile production --local",
    "build:production:tv": "eas build --profile production_tv",
    "build:production:tv:local": "eas build --profile production_tv --local",
    "build:production_apk": "eas build --profile production_apk",
    "build:production_apk:local": "eas build --profile production_apk --local",
    "build:production_apk:tv": "eas build --profile production_tv_apk",
    "build:production_apk:tv:local": "eas build --profile production_tv_apk --local",
    "build:ui": "pnpm --filter ./packages/remote-ui build && node scripts/embed-web-ui.mjs",
    "new-whats-new": "node scripts/new-whats-new.mjs",
    "generate-whats-new": "node scripts/generate-whats-new-registry.mjs",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:agent": "CI=true NO_COLOR=1 jest --no-watchman --silent",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "postinstall": "lefthook install",
    "test:e2e:sync": "jest --config ./scripts/sync-e2e/jest-e2e.config.js",
    "test:e2e:sync:trakt": "jest --config ./scripts/sync-e2e/jest-e2e.config.js --testNamePattern=Trakt",
    "test:e2e:sync:simkl": "jest --config ./scripts/sync-e2e/jest-e2e.config.js --testNamePattern=Simkl",
    "test:e2e:addon": "pnpm --filter @dodostream/e2e-addon test",
    "e2e:addon": "pnpm --filter @dodostream/e2e-addon start",
    "e2e:android": "node scripts/e2e/run-android.mjs",
    "e2e:android:all": "node scripts/e2e/run-all.mjs",
    "e2e:android:build": "node scripts/e2e/build-release.mjs",
    "test:e2e:tools": "node --test scripts/e2e/test/*.test.mjs",
    "test:e2e:tools:agent": "node --test --test-reporter=dot scripts/e2e/test/*.test.mjs",
    "verify:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 && docker run --rm -v \"$PWD:/repo\" -w /repo ghcr.io/zizmorcore/zizmor@sha256:a2eb396d886c053073405c7a980f2139ba2248ec172243cfa3841e57196e8101 --no-progress --color never .github/workflows",
    "verify:agent": "node scripts/agent-verify.mjs",
    "verify:ci": "pnpm verify:agent"
  },
  "dependencies": {
    "@anatine/zod-openapi": "2.2.8",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@legendapp/list": "3.3.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/lucide": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@react-native/jest-preset": "0.86.3",
    "@ronradtke/react-native-markdown-display": "^9.0.3",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "^5.102.8",
    "drizzle-orm": "^0.45.2",
    "expo": "^57.0.23",
    "expo-asset": "~57.0.17",
    "expo-build-disk-cache": "^0.7.2",
    "expo-build-properties": "^57.0.20",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-font": "^57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-libvlc-player": "57.0.28",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "i18next": "^26.4.1",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-immersive-mode": "^2.0.2",
    "react-native-nitro-http-server": "^1.9.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-video": "DodoraApp/react-native-video#77549e6c9f7e0f51b364f1060fca5db7cbc98d69",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.1",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "^57.0.15",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@testing-library/react-native": "^13.3.3",
    "@ts-rest/core": "3.52.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.9",
    "@types/react": "~19.2.18",
    "@types/stremio-addon-sdk": "^1.6.12",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "expo-doctor": "^1.20.4",
    "expo-sqlite-mock": "^4.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "trakt-api": "github:trakt/trakt-api",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "zod": "3.25.76"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "packageManager": "pnpm@10.28.0",
  "private": true
}
